<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Expanded Floating Control Panel -->
    <LinearLayout
        android:id="@+id/floatingPanelContainer"
        android:layout_width="256dp"
        android:layout_height="236dp"
        android:background="@drawable/bg_floating_panel"
        android:orientation="vertical">

        <!-- Draggable Header Bar -->
        <LinearLayout
            android:id="@+id/floatingDragHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/floating_header_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Drag"
                android:src="@drawable/ic_drag_handle" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/floating_title"
                android:textColor="@color/emerald_neon"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnFloatMinimize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Minimize"
                android:src="@drawable/ic_minimize" />

            <ImageButton
                android:id="@+id/btnFloatMaximize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Maximize"
                android:src="@drawable/ic_maximize" />

            <ImageButton
                android:id="@+id/btnFloatClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Panel Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFloatScreen1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/floating_screen1"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_emerald"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFloatScreen2"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/floating_screen2"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_emerald"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFloatSplitLaunch"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/floating_split"
                    android:textAllCaps="false"
                    android:textColor="@color/emerald_neon"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFloatDashboard"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/floating_dashboard"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFloatFeedback"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="@string/floating_note"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Bottom Resize Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drag corner to resize"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/btnFloatResizeHandle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Resize"
                android:src="@drawable/ic_resize" />
        </LinearLayout>
    </LinearLayout>

    <!-- Minimized Draggable Bubble -->
    <FrameLayout
        android:id="@+id/floatingBubbleContainer"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_floating_bubble"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />
    </FrameLayout>
</FrameLayout>
